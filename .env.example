APP_NAME="Service Requests API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# SQLite is the zero-setup default (the file is created by `composer setup`).
DB_CONNECTION=sqlite
# MySQL / PostgreSQL: switch DB_CONNECTION to mysql or pgsql and fill these in.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=service_requests
# DB_USERNAME=root
# DB_PASSWORD=

# --- Queue / cache / session --------------------------------------------
# Notifications are sent by queued jobs. Run `php artisan queue:work` to process them.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=array

# --- Mail ---------------------------------------------------------------
# "log" writes outgoing e-mails to storage/logs/laravel.log so you can read them locally.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth ---------------------------------------------------------------
# Personal access token lifetime in minutes (null = never expires).
SANCTUM_TOKEN_EXPIRATION=1440

# --- Business settings (see config/service_requests.php) -----------------
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
NOTIFICATIONS_ENABLED=true
